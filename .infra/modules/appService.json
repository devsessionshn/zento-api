{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "16447122262357595206"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "appServicePlanName": {
      "type": "string"
    },
    "webAppName": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "appServicePlanSkuName": {
      "type": "string",
      "defaultValue": "S1"
    },
    "appServicePlanSkuTier": {
      "type": "string",
      "defaultValue": "Standard"
    }
  },
  "variables": {
    "appServicePlanFullName": "[format('{0}-{1}', parameters('appServicePlanName'), parameters('environment'))]",
    "webAppFullName": "[format('{0}-{1}', parameters('webAppName'), parameters('environment'))]",
    "commonTags": {
      "environment": "[parameters('environment')]",
      "createdBy": "github-actions",
      "project": "zento-api"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('appServicePlanFullName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServicePlanSkuName')]",
        "tier": "[parameters('appServicePlanSkuTier')]",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('webAppFullName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanFullName'))]",
        "siteConfig": {
          "linuxFxVersion": "DOTNET|10.0",
          "alwaysOn": false,
          "http20Enabled": true,
          "minTlsVersion": "1.2"
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanFullName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', variables('webAppFullName'), 'appsettings')]",
      "properties": {
        "ASPNETCORE_ENVIRONMENT": "[parameters('environment')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('webAppFullName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webAppFullName')), '2023-01-01').defaultHostName)]"
    },
    "webAppName": {
      "type": "string",
      "value": "[variables('webAppFullName')]"
    },
    "appServicePlanId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanFullName'))]"
    },
    "webAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('webAppFullName'))]"
    }
  }
}